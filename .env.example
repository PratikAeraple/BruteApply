# Local demo mode only. Never put production credentials here.
APP_ENV=development
DEMO_MODE=true
DATABASE_URL=postgresql://bruteapply:replace-local-only@localhost:5432/bruteapply
REDIS_URL=redis://localhost:6379/0
CF_ACCESS_ISSUER=https://YOUR-TEAM.cloudflareaccess.com
CF_ACCESS_AUD=replace-with-exact-access-application-audience
OWNER_EMAIL=owner@example.invalid
DOCUMENT_ROOT=./private-data/documents
DOCUMENT_ENCRYPTION_KEY_FILE=./private-data/secrets/documents.key
OPENAI_API_KEY_FILE=./private-data/secrets/openai-api-key
GOOGLE_OAUTH_CLIENT_FILE=./private-data/secrets/google-client.json
GOOGLE_TOKEN_FILE=./private-data/secrets/google-token.json
SHEET_ID=replace-with-owner-approved-sheet-id
TIMEZONE=America/Toronto
MAX_DAILY_APPLICATIONS=3
MAX_COMPANY_APPLICATIONS_PER_DAY=1
MINIMUM_MATCH_SCORE=75
AUTONOMOUS_SUBMISSION_ENABLED=false
